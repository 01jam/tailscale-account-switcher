{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tailscale Account Switcher",
  "version": "0.1.1",
  "identifier": "studio.hund.tailscale-switch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tailscale Account Switcher",
        "width": 480,
        "height": 680,
        "minWidth": 400,
        "minHeight": 460,
        "maxWidth": 720,
        "maxHeight": 1400,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Switch between the Tailscale accounts on this computer",
    "longDescription": "Lists the Tailscale accounts logged in on this computer and switches, adds or removes them from a window or the system tray.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
